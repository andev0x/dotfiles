# =============================================================================
# Ghostty — Optimized Smooth Native Config (tmux-aware)
# Author: anvndev
# Profile: Backend / Cloud DevOps
# Optimized for: macOS + Linux | Neovim + Tmux
#
# tmux is the source of truth for prefixes, scrolling, selection and the
# status bar. This file only changes the Ghostty side so the two never fight:
#   • tmux owns the mouse/history/clipboard -> Ghostty stays out of the way
#   • Ghostty chrome matches tmux's "obsidian" dark-green palette
#   • keys Ghostty encodes must never collide with the C-a prefix
# =============================================================================

# =============================================================================
# Font & Typography
# =============================================================================

# Using the standard Nerd Font (non-Mono) allows icons to scale and render better
font-family = JetBrainsMono Nerd Font
font-size = 16

# Provide ample breathing room for Nerd Font icons to prevent clipping
adjust-cell-height = 15%
adjust-cell-width = 0%

# Disable ligatures for strict and consistent code alignment
font-feature = -liga

# Keep Retina text rendering crisp on macOS displays
font-thicken = false

# =============================================================================
# Theme & Aesthetics (Premium High-Contrast Dark Green)
# =============================================================================
#
# Chrome is aligned with tmux's obsidian theme so the pane background and the
# status bar/popups read as one surface. tmux tokens:
#   base=#0a0d0b  text=#c6d4c9  focus=#8fc7a0  slate=#1e2a22
#   dim=#5f6f63   alert=#a9d9ba  data=#4f8b6b

# Deep forest dark green base for ultra eye comfort (same value as tmux `base`)
background = #0a0d0b
foreground = #d7e3dc

# Solid mint BLOCK caret: a chunky, always-on block reads as smooth and
# immediate while typing (no thin-bar flicker, no blink gaps).
cursor-color = #a6e3a1
cursor-style = block
cursor-opacity = 1
# Steady, non-blinking block. Set to `true` if you prefer a blinking caret.
cursor-style-blink = false

# Selection mirrors tmux copy-mode (`mode-style bg=slate,fg=notice`), so text
# selected natively in Ghostty and inside tmux looks identical.
selection-background = #1e2a22
selection-foreground = #a9d9ba

bold-is-bright = false
minimum-contrast = 1.1

# Base ANSI Colors (Restored vibrancy for prominent visibility)
palette = 0=#161f1b
palette = 1=#ef7e7e
palette = 2=#98d393
palette = 3=#f0b475
palette = 4=#89b4fa
palette = 5=#e39ee3
palette = 6=#7bc5b6
palette = 7=#b5caa0

# Bright ANSI Colors (Pop out colors for prompts like Starship and Neovim)
palette = 8=#475750
palette = 9=#fca2a2
palette = 10=#a6e3a1
palette = 11=#fab387
palette = 12=#a4c5fd
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#d7e3dc

# =============================================================================
# Window & Compositor (Optimized for Pure Speed)
# =============================================================================

# Subtle translucency + native macOS blur ("premium" look).
# Note: `background-blur-radius` is the legacy name in 1.4 — the canonical
# option is `background-blur`. Any opacity < 1 forces compositing; set
# background-opacity = 1 and background-blur = false if you want maximum
# frame-rate consistency during heavy output.
background-opacity = 0.94
background-blur = 6

# Stable color rendering
window-colorspace = srgb

macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden

# Comfortable and balanced padding for a cleaner UI layout
window-padding-x = 15
window-padding-y = 4
window-padding-balance = true

# Reduce unnecessary window state retention
window-save-state = default
window-inherit-working-directory = true

# Cleaner resize behavior
resize-overlay = never

# =============================================================================
# Advanced Extreme Performance Engine
# =============================================================================

# No custom shader: keeps GPU frame pacing stable. `custom-shader = none` is
# NOT a valid value — it resolves to the literal path <config-dir>/none and
# only logs a load error, so the line is left disabled instead.
# Uncomment to opt back in:
# custom-shader = shaders/cursor_tail.glsl

# tmux keeps 50,000 lines in `history-limit`, so Ghostty only needs enough
# for surfaces that are not inside tmux. `scrollback-limit` is a legacy alias
# that maps to *bytes* in 1.4 (5,000 bytes ≈ 50 lines!), so use the explicit
# limits below instead.
scrollback-limit-lines = 10000
scrollback-limit-bytes = 50000000

mouse-hide-while-typing = true

clipboard-trim-trailing-spaces = true

quit-after-last-window-closed = true

# =============================================================================
# tmux Interop (Ghostty side only — tmux config is never touched)
# =============================================================================
# tmux runs with: prefix C-a, `mouse on`, `set-clipboard on`,
# `extended-keys csi-u`, `history-limit 50000`, truecolor. The settings below
# keep Ghostty from duplicating or swallowing that behaviour.
#
# Truecolor and CSI-u (`extended-keys`) are negotiated by tmux for the client
# terminal; Ghostty already supports both, so there is nothing to enable here.

# Let tmux receive wheel/mouse events (it owns scrolling via copy-mode).
mouse-reporting = true

# Stock wheel feel. Inside tmux the wheel arrives as mouse events (tmux owns
# scrolling), so a multiplier only affects surfaces outside tmux — where 2x
# overshoots. Keep the defaults.
mouse-scroll-multiplier = precision:1,discrete:3

# Shift + drag always starts a NATIVE Ghostty selection even though tmux
# requested mouse reporting (`never` also ignores XTSHIFTESCAPE if an inner
# app asks for shift to be forwarded). Workflow: Shift+drag, then Cmd+C.
mouse-shift-capture = never

# Mouse drags belong to tmux copy-mode, so Ghostty must not copy as well.
copy-on-select = none

# tmux's `set-clipboard on` writes the clipboard via OSC 52; keep that allowed.
# (tmux's yank binding uses pbcopy first, so this is only the fallback path.)
clipboard-write = allow

# `clipboard-read = allow` lets apps query the clipboard (OSC 52 read).
# tmux never needs this; set to `ask`/`deny` to tighten it.
clipboard-read = allow

# `bold-is-bright = false` (above) matters here: tmux emits bold attributes
# and must not have its palette silently brightened by Ghostty.

# =============================================================================
# Cursor, Input & Shell Integration
# =============================================================================

# Native cursor movement behavior
cursor-click-to-move = true

# Stable shell integration. `path` keeps the `ghostty` CLI reachable even
# though tmux panes inherit a fresh PATH; `sudo` preserves TERM under sudo.
# ssh-* features stay off: inside tmux TERM is tmux-256color, so they would
# add remote work for no benefit.
# `no-cursor` is REQUIRED: the `cursor` feature force-sets a BAR at the prompt
# and would silently override `cursor-style = block` above.
shell-integration = detect
shell-integration-features = no-cursor,sudo,title,path

# Native terminal identity. tmux overrides this to `tmux-256color` for panes
# (default-terminal), so this only applies outside a session.
term = xterm-ghostty

# REQUIRED for tmux's `bind -n M-h/j/k/l` pane navigation: Option must emit
# ESC+key so tmux receives Meta. Without this, Option+letter types accents.
macos-option-as-alt = true

# =============================================================================
# Keybindings: tmux-safe line navigation
# =============================================================================
# Ghostty's defaults encode Cmd+Left/Cmd+Right as Ctrl-A / Ctrl-E. Ctrl-A is
# tmux's prefix, so Cmd+Left would silently arm the prefix instead of jumping
# to the start of the line. Send Ghostty's own Home/End sequences (khome=\EOH,
# kend=\EOF in xterm-ghostty) so tmux decodes and re-encodes them normally;
# readline, zsh, fish and Neovim all map them to line start/end.
keybind = cmd+arrow_left=text:\x1bOH
keybind = cmd+arrow_right=text:\x1bOF

# =============================================================================
# Keybindings: Tabs
# =============================================================================

keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

keybind = cmd+]=next_tab
keybind = cmd+[=previous_tab

keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5

# =============================================================================
# Keybindings: Windows & Splits
# =============================================================================

keybind = cmd+n=new_window

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

keybind = cmd+ctrl+h=goto_split:left
keybind = cmd+ctrl+j=goto_split:bottom
keybind = cmd+ctrl+k=goto_split:top
keybind = cmd+ctrl+l=goto_split:right

keybind = cmd+shift+f=toggle_fullscreen

# =============================================================================
# Keybindings: Font Scaling
# =============================================================================

keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# =============================================================================
# Keybindings: Clipboard & System
# =============================================================================

keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

keybind = cmd+shift+c=clear_screen

# Reload configuration instantly
keybind = cmd+r=reload_config
